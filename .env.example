# Copy these settings into your private .env file. Never put API keys in HTML/JS.
OPENROUTER_API_KEY=replace_with_a_rotated_key
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENAQ_API_KEY=replace_with_your_openaq_api_key
FIRMS_MAP_KEY=replace_with_your_rotated_nasa_firms_key
EARTHPULSE_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000,https://YOUR-STATIC-SITE.onrender.com
